model anomaly_logs{
  id Int @id @default(autoincrement())
  anomaly_details Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // anomaly_category String
  // anomaly_time String
  // anomaly_score Float
  cameraId Int
  camera Camera @relation(fields: [cameraId], references: [id])
}

model VideoRecording{
  id Int @id @default(autoincrement())
  cameraId Int
  camera Camera @relation(fields: [cameraId], references: [id])
  cameraIp String?
  cameraLocation String?
  cameraStatus   String?
  recordingURL   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  camera         camera   @relation(fields: [cameraId], references: [id], map: "VideoRecording_cameraId_fkey")

  @@index([cameraId], map: "VideoRecording_cameraId_fkey")
}
