generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Alert {
  id           Int      @id @default(autoincrement())
  alert_number String
  date         DateTime @default(now())
  time         String
  alert_link   String?
  camera_num   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  camera       camera   @relation(fields: [camera_num], references: [id])

  @@index([camera_num], map: "alerts_camera_num_fkey")
  @@map("alerts")
}

model anomaly_logs {
  id              Int      @id @default(autoincrement())
  anomaly_details Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  cameraId        Int
  camera          camera   @relation(fields: [cameraId], references: [id])

  @@index([cameraId], map: "anomaly_logs_cameraId_fkey")
}

model apikey {
  id        String   @id
  key       String
  name      String   @unique(map: "ApiKey_name_key")
  userId    Int
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ApiKey_userId_fkey")

  @@index([userId], map: "ApiKey_userId_fkey")
}

model camera {
  id             Int              @id @default(autoincrement())
  cameraModel    String
  cameraIp       String
  cameraUsername String
  cameraPassword String
  cameraLocation String
  cameraStatus   String           @default("Active")
  autoFlash      Boolean?         @default(false)
  cameraVoice    Boolean?         @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  processedUrl   String?
  alerts         Alert[]
  anomaly_logs   anomaly_logs[]
  videorecording videorecording[]
}

model gpuinfo {
  id                 Int      @id @default(autoincrement())
  utilizationPercent Float
  memoryStatus       String
  allocatedGB        Float
  reservedGB         Float
  available          Boolean
  createdAt          DateTime @default(now())
}

model role {
  id          Int      @id @default(autoincrement())
  name        String   @unique(map: "Role_name_key")
  description String?
  permissions Json
  role        String   @unique(map: "Role_role_key")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        user[]
}

model session {
  id           String   @id
  sessionToken String   @unique(map: "Session_sessionToken_key")
  userId       Int
  expires      DateTime
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Session_userId_fkey")

  @@index([userId], map: "Session_userId_fkey")
}

model systemstatus {
  id               Int      @id @default(autoincrement())
  totalCameras     Int
  liveCamerasCount Int
  degradedCount    Int
  offlineCount     Int
  overallHealth    String
  statusSummary    String
  timestamp        DateTime @default(now())
}

model user {
  id                    Int       @id @default(autoincrement())
  email                 String    @unique(map: "User_email_key")
  name                  String
  password              String
  roleId                Int
  profilePicture        String?   @db.VarChar(300)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  passwordResetToken    String?
  phoneNumber           String
  status                String
  passwordResetTokenExp DateTime?
  apikey                apikey[]
  session               session[]
  role                  role      @relation(fields: [roleId], references: [id], map: "User_roleId_fkey")

  @@index([roleId], map: "User_roleId_fkey")
}

model verificationtoken {
  id         String   @id
  identifier String
  token      String   @unique(map: "VerificationToken_token_key")
  expires    DateTime

  @@unique([identifier, token])
}

model Camera{
  id Int @id @default(autoincrement())
  cameraModel String
  cameraIp String
  cameraUsername String
  cameraPassword String
  cameraLocation String
  cameraStatus String @default("Active")
  autoFlash Boolean? @default(false)
  cameraVoice Boolean? @default(false)
  rtspUrl String? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
  videoRecording VideoRecording[]
  anomaly_logs anomaly_logs[] 
}
